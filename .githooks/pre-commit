#!/usr/bin/env bash
set -euo pipefail

uv run ruff check .
uv run ruff format --check .
uv run python scripts/regen_guard.py verify
uv run python scripts/regen_guard.py stale --fail-on-stale

if git diff --cached --name-only | grep -qE '^scratch/'; then
  echo "ERROR: Attempted to commit files in scratch/. Extract findings to specs/ and delete scratch/ files." >&2
  exit 1
fi
